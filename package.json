{
    "name": "paper-wallet",
    "version": "3.2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky",
        "task:deploy": "cross-env-shell ./scripts/deploy.sh",
        "task:deploy:workflow": "cross-env-shell ./scripts/deploy-via-workflow.sh",
        "task:release": "cross-env-shell ./scripts/release.sh",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test --reporter=line",
        "test:unit": "vitest run --coverage"
    },
    "dependencies": {
        "@chenfengyuan/vue-qrcode": "^2.0.0",
        "@noble/curves": "^1.9.0",
        "@noble/hashes": "^1.8.0",
        "@scure/base": "^1.2.0",
        "@scure/bip39": "^1.5.0",
        "animate.css": "^4.1.1",
        "html2canvas": "^1.4.1",
        "tailwindcss": "^3.4.17",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.0",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^3.2.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.20",
        "cross-env": "^10.0.0",
        "eslint": "^9.30.0",
        "eslint-plugin-vue": "^10.3.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.1.0",
        "postcss": "^8.5.0",
        "prettier": "^3.6.0",
        "typescript": "^5.8.0",
        "vite": "^7.0.0",
        "vite-plugin-pwa": "^1.0.0",
        "vitest": "^3.2.0",
        "vue-tsc": "^3.0.0",
        "workbox-window": "^7.4.1"
    },
    "lint-staged": {
        "*.{ts,vue,js,cjs,mjs}": [
            "eslint --fix"
        ],
        "*.{ts,js,json,md,vue,cjs,mjs,yml}": [
            "prettier --write"
        ]
    }
}
